# Kopiere diese Datei nach .env und trage deine Werte ein. .env wird nie committet.

# Stripe Dashboard -> Entwickler -> API-Schlüssel (zum Testen: sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx

# Signing-Secret des Webhooks (whsec_...) – siehe README
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Öffentliche Adresse des Shops, ohne Slash am Ende (lokal: http://localhost:3000)
PUBLIC_URL=http://localhost:3000

PORT=3000
